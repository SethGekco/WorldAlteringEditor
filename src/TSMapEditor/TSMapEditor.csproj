<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- stride-2048 fork: dual-platform build. Building on Windows produces the upstream
         net8.0-windows + MonoGame WindowsDX + WinForms editor; building elsewhere produces the
         net8.0 + MonoGame DesktopGL (OpenGL) editor. All Windows-only code is guarded with
         "#if WINDOWS" (auto-defined by the -windows target framework). -->
    <IsWindowsBuild>$([MSBuild]::IsOSPlatform('Windows'))</IsWindowsBuild>
    <TargetFramework Condition="'$(IsWindowsBuild)' == 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(IsWindowsBuild)' != 'true'">net8.0</TargetFramework>
    <OutputType Condition="'$(IsWindowsBuild)' == 'true'">WinExe</OutputType>
    <OutputType Condition="'$(IsWindowsBuild)' != 'true'">Exe</OutputType>
    <UseWindowsForms Condition="'$(IsWindowsBuild)' == 'true'">true</UseWindowsForms>
    <ImportWindowsDesktopTargets Condition="'$(IsWindowsBuild)' == 'true'">true</ImportWindowsDesktopTargets>
    <MonoGamePlatform Condition="'$(IsWindowsBuild)' == 'true'">Windows</MonoGamePlatform>
    <MonoGamePlatform Condition="'$(IsWindowsBuild)' != 'true'">DesktopGL</MonoGamePlatform>
    <AssemblyName>WorldAlteringEditor</AssemblyName>
    <Deterministic>false</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseVSHostingProcess>true</UseVSHostingProcess>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject />
  </PropertyGroup>
  <!-- Windows-only packaging metadata; inert on the Linux/DesktopGL build. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>editoricon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- stride-2048 fork / DesktopGL: the auto-generated WinForms app-settings class is unused and
       depends on System.Configuration.ApplicationSettingsBase (provided only via WinForms). -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Properties/Settings.Designer.cs" />
  </ItemGroup>
